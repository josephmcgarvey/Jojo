{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jojo",
  "mainBinaryName": "jojo",
  "version": "0.2.5",
  "identifier": "com.mcgstrategic.jojo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pwsh -NoProfile -File ../scripts/stage-daemon.ps1 -Profile release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Jojo",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 420,
        "decorations": false,
        "backgroundColor": "#060816"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "resources/daemon/*": "daemon/" }
  }
}
